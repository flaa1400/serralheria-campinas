---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const postsOrdenados = allPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<Layout title="Blog & Dicas de Serralheria | Serralheria em Campinas" description="Dicas de obras, manutenção de portões automáticos, escolha de mezaninos e novidades em estruturas metálicas em Campinas.">
  <!-- Hero do Blog -->
  <section class="section-spacing bg-white border-b border-gray-100 text-center">
    <div class="safe-container max-w-4xl mx-auto">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-50 text-secondary text-xs font-bold uppercase tracking-wider mb-6">
        Portal de Notícias & Dicas
      </span>
      <h1 class="text-4xl md:text-6xl font-black text-gray-900 leading-tight mb-8">
        Dicas de Serralheria, Segurança e <span class="text-secondary">Obras em Campinas</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-600 leading-relaxed">
        Artigos práticos para tirar suas dúvidas antes de construir, reformar ou instalar portões e estruturas metálicas.
      </p>
    </div>
  </section>

  <!-- Lista de Posts -->
  <section class="section-spacing bg-slate-50 border-b border-gray-200/60">
    <div class="safe-container">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-12">
        {postsOrdenados.map((post) => (
          <article class="bg-white p-10 rounded-3xl border border-gray-200/80 shadow-sm hover:shadow-xl transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-center gap-3 text-xs font-bold text-gray-400 mb-4">
                <span class="bg-blue-50 text-secondary px-3 py-1 rounded-full uppercase tracking-wider">{post.data.category}</span>
                <span>• {post.data.readTime}</span>
              </div>
              <h2 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-secondary transition-colors">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h2>
              <p class="text-gray-600 text-sm leading-relaxed mb-6">
                {post.data.description}
              </p>
            </div>
            <div class="pt-6 border-t border-gray-100 flex items-center justify-between">
              <span class="text-xs text-gray-400 font-medium">{post.data.pubDate}</span>
              <a href={`/blog/${post.slug}`} class="text-secondary font-bold text-sm inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                Ler Artigo Completo &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
