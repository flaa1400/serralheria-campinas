---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../data/config';
import { bairrosData } from '../data/bairros';
---

<Layout title="Fale Conosco" description="Entre em contato com a Serralheria em Campinas. Telefone, WhatsApp, endereço e formulário para solicitação de orçamento rápido.">
  <!-- Hero Contato -->
  <section class="section-spacing bg-white border-b border-gray-100 text-center">
    <div class="safe-container max-w-4xl mx-auto">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-50 text-secondary text-xs font-bold uppercase tracking-wider mb-6">
        Canais de Atendimento
      </span>
      <h1 class="text-4xl md:text-6xl font-black text-gray-900 leading-tight mb-8">
        Fale com Nossa Equipe em <span class="text-secondary">Campinas</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-600 leading-relaxed max-w-2xl mx-auto">
        Estamos à disposição para tirar dúvidas, realizar medições técnicas e enviar orçamentos sem compromisso.
      </p>
    </div>
  </section>

  <!-- NAP + Formulário de Contato -->
  <section class="section-spacing bg-slate-50">
    <div class="safe-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-start">
        
        <!-- Bloco NAP (Name, Address, Phone) & Atendimento -->
        <div class="space-y-8">
          <div class="bg-white p-10 lg:p-12 rounded-3xl border border-gray-200/80 shadow-sm space-y-6">
            <h2 class="text-2xl font-black text-gray-900 mb-6">Informações da Empresa</h2>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-50 text-secondary rounded-2xl flex items-center justify-center font-bold text-xl shrink-0">📍</div>
              <div>
                <h3 class="font-bold text-gray-900 text-base">Endereço Principal</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{SITE_CONFIG.address.full}</p>
                <p class="text-xs text-gray-400 mt-1">Atendimento presencial e visitas técnicas em toda Campinas.</p>
              </div>
            </div>

            <div class="flex items-start gap-4 border-t border-gray-100 pt-6">
              <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center font-bold text-xl shrink-0">💬</div>
              <div>
                <h3 class="font-bold text-gray-900 text-base">WhatsApp Comercial</h3>
                <p class="text-gray-600 text-sm font-semibold">
                  <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 transition-all duration-300">
                    {SITE_CONFIG.whatsappFormatted}
                  </a>
                </p>
                <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-xs text-emerald-600 font-bold hover:underline inline-block mt-1">
                  Iniciar conversa imediata no WhatsApp &rarr;
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4 border-t border-gray-100 pt-6">
              <div class="w-12 h-12 bg-blue-50 text-secondary rounded-2xl flex items-center justify-center font-bold text-xl shrink-0">✉️</div>
              <div>
                <h3 class="font-bold text-gray-900 text-base">E-mail Comercial</h3>
                <p class="text-gray-600 text-sm font-semibold">
                  <a href={`mailto:${SITE_CONFIG.email}`} class="hover:text-secondary transition-all duration-300">
                    {SITE_CONFIG.email}
                  </a>
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 border-t border-gray-100 pt-6">
              <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center font-bold text-xl shrink-0">⏰</div>
              <div>
                <h3 class="font-bold text-gray-900 text-base">Horário de Funcionamento</h3>
                <p class="text-gray-600 text-sm">Segunda a Sexta: 07h30 às 18h00</p>
                <p class="text-gray-600 text-sm">Sábado: 08h00 às 12h00</p>
              </div>
            </div>
          </div>

          <!-- Card Bairros Atendidos em Campinas -->
          <div class="bg-secondary text-white p-10 rounded-3xl shadow-xl">
            <h3 class="text-xl font-bold mb-4">Bairros Atendidos em Campinas</h3>
            <p class="text-blue-100 text-xs leading-relaxed mb-4">
              {bairrosData.map((b) => b.name).sort((a, b) => a.localeCompare(b)).join(', ')} e região.
            </p>
            <span class="text-xs text-primary font-bold">✓ Equipe própria com deslocamento rápido</span>
          </div>
        </div>

        <!-- Formulário de Contato -->
        <div class="bg-white p-10 lg:p-12 rounded-3xl border border-gray-200/80 shadow-xl">
          <h2 class="text-2xl font-black text-gray-900 mb-2">Solicitar Orçamento Online</h2>
          <p class="text-gray-600 text-sm mb-8">Preencha o formulário abaixo e receba nossa resposta rápida.</p>

          <form class="space-y-5">
            <div>
              <label for="name" class="block text-sm font-bold text-gray-900 mb-2">Seu Nome Completo</label>
              <input type="text" id="name" required class="w-full bg-slate-50 border border-gray-200 rounded-xl px-4 py-3.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-secondary focus:bg-white transition-all" placeholder="Ex: Roberto Silva" />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="phone" class="block text-sm font-bold text-gray-900 mb-2">WhatsApp / Telefone</label>
                <input type="tel" id="phone" required class="w-full bg-slate-50 border border-gray-200 rounded-xl px-4 py-3.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-secondary focus:bg-white transition-all" placeholder={SITE_CONFIG.phone} />
              </div>
              <div>
                <label for="email" class="block text-sm font-bold text-gray-900 mb-2">Seu E-mail (Opcional)</label>
                <input type="email" id="email" class="w-full bg-slate-50 border border-gray-200 rounded-xl px-4 py-3.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-secondary focus:bg-white transition-all" placeholder="contato@exemplo.com" />
              </div>
            </div>

            <div>
              <label for="neighborhood" class="block text-sm font-bold text-gray-900 mb-2">Bairro em Campinas</label>
              <input type="text" id="neighborhood" class="w-full bg-slate-50 border border-gray-200 rounded-xl px-4 py-3.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-secondary focus:bg-white transition-all" placeholder="Ex: Cambuí" />
            </div>

            <div>
              <label for="service" class="block text-sm font-bold text-gray-900 mb-2">Serviço Desejado</label>
              <select id="service" class="w-full bg-slate-50 border border-gray-200 rounded-xl px-4 py-3.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-secondary focus:bg-white transition-all">
                <option value="portao">Portão Automático / Manual</option>
                <option value="mezanino">Mezanino Metálico / Estrutura</option>
                <option value="cobertura">Cobertura Metálica / Telhado Sanduíche</option>
                <option value="grade">Grades de Proteção / Fechamento</option>
                <option value="corrimao">Corrimão / Guarda-Corpo</option>
                <option value="galpao">Galpão Estrutural Industrial</option>
                <option value="outro">Outro Serviço sob Medida</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-bold text-gray-900 mb-2">Detalhes do Projeto</label>
              <textarea id="message" rows="4" required class="w-full bg-slate-50 border border-gray-200 rounded-xl px-4 py-3.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-secondary focus:bg-white transition-all" placeholder="Descreva as especificações ou solicite uma visita de medição técnica."></textarea>
            </div>

            <button type="submit" class="w-full bg-primary hover:bg-yellow-400 text-accent font-black py-4 rounded-xl text-base transition-all shadow-lg shadow-primary/30 hover:shadow-xl border border-amber-400/60 mt-2">
              Enviar Solicitação de Orçamento ⚡
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
  <script define:vars={{ bairrosData, whatsappNumber: SITE_CONFIG.whatsappNumber }}>
    // Form Submit to WhatsApp
    const form = document.querySelector('form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        const name = document.querySelector('#name').value.trim();
        const phone = document.querySelector('#phone').value.trim();
        const email = document.querySelector('#email').value.trim();
        const neighborhood = document.querySelector('#neighborhood').value.trim();
        const serviceSelect = document.querySelector('#service');
        const serviceText = serviceSelect.options[serviceSelect.selectedIndex].text;
        const details = document.querySelector('#message').value.trim();

        let message = `Olá, gostaria de solicitar um orçamento pelo site:\n\n`;
        message += `*Nome:* ${name}\n`;
        message += `*Telefone/WhatsApp:* ${phone}\n`;
        if (email) {
          message += `*E-mail:* ${email}\n`;
        }
        if (neighborhood) {
          message += `*Bairro:* ${neighborhood}\n`;
        }
        message += `*Serviço:* ${serviceText}\n`;
        message += `*Detalhes:* ${details}`;

        const encodedMessage = encodeURIComponent(message);
        const whatsappUrl = `https://api.whatsapp.com/send?phone=${whatsappNumber}&text=${encodedMessage}`;
        
        window.open(whatsappUrl, '_blank');
      });
    }

    const urlParams = new URLSearchParams(window.location.search);
    const b = urlParams.get('b');
    if (b) {
      const bairroObj = bairrosData.find(x => x.slug === b);
      if (bairroObj) {
        const prep = bairroObj.preposition.charAt(0).toUpperCase() + bairroObj.preposition.slice(1);
        const neighborhoodLabel = `${bairroObj.preposition} ${bairroObj.name} em Campinas`;
        const capitalizedLabel = `${prep} ${bairroObj.name} em Campinas`;

        // 1. Update Document Title
        document.title = document.title.replace(/em\s+Campinas/gi, capitalizedLabel);

        // 2. Walk the DOM within <main> and replace text
        const walkAndReplaceText = (node) => {
          if (node.nodeType === Node.TEXT_NODE) {
            let val = node.nodeValue;
            if (/em\s+Campinas/i.test(val)) {
              val = val.replace(/em\s+Campinas/gi, (match) => {
                if (match.startsWith('E')) {
                  return capitalizedLabel;
                }
                return neighborhoodLabel;
              });
              node.nodeValue = val;
            }
          } else {
            if (node.nodeName !== 'SCRIPT' && node.nodeName !== 'STYLE' && node.id !== 'bairros') {
              for (let child of node.childNodes) {
                walkAndReplaceText(child);
              }
            }
          }
        };

        const mainEl = document.querySelector('main');
        if (mainEl) {
          walkAndReplaceText(mainEl);
        }

        // 3. Pre-fill form input
        const neighborhoodInput = document.querySelector('#neighborhood');
        if (neighborhoodInput) {
          neighborhoodInput.value = bairroObj.name;
        }

        // 4. Update links
        const links = document.querySelectorAll('a');
        links.forEach(a => {
          const href = a.getAttribute('href');
          if (href) {
            if (href.startsWith('/servicos/')) {
              try {
                const url = new URL(href, window.location.origin);
                url.searchParams.set('b', b);
                a.setAttribute('href', url.pathname + url.search);
              } catch(e) {}
            } else if (href.includes('wa.me') || href.includes('whatsapp.com')) {
              try {
                const decodedHref = decodeURIComponent(href);
                const replacedHref = decodedHref.replace(/em\s+Campinas/gi, neighborhoodLabel);
                a.setAttribute('href', encodeURI(replacedHref));
              } catch(e) {
                const replacedHref = href.replace(/em\s+Campinas/gi, encodeURIComponent(neighborhoodLabel));
                a.setAttribute('href', replacedHref);
              }
            }
          }
        });
      }
    }
  </script>
</Layout>
