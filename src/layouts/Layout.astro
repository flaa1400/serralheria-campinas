---
import SEO from '../components/SEO.astro';
import SchemaLocalBusiness from '../components/SchemaLocalBusiness.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro';
import { SITE_CONFIG } from '../data/config';
import { getCollection } from 'astro:content';

const allServicos = await getCollection('servicos');
const servicosOrdenados = allServicos.sort((a, b) => a.data.order - b.data.order);

const shortTitles: Record<string, string> = {
  'estruturas-metalicas': 'Estruturas Metálicas',
  'mezaninos-metalicos': 'Mezaninos Metálicos',
  'serralheiro-portao': 'Serralheiro de Portões',
  'manutencao-portao': 'Manutenção de Portões',
  'instalacao-portao': 'Instalação de Portões',
  'portas-de-aco': 'Portas de Aço',
  'grades-e-corrimao': 'Grades e Corrimão',
  'servicos-de-solda': 'Serviços de Solda',
  'coberturas-metalicas': 'Coberturas & Telhados'
};

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { 
  title, 
  description,
  image,
  noindex = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Componente Centralizado de SEO & Open Graph Meta Tags -->
    <SEO title={title} description={description} image={image} noindex={noindex} />
    
    <!-- Schema JSON-LD de LocalBusiness para Google Maps -->
    <SchemaLocalBusiness />
    
    <!-- Tipografia Inter para Acessibilidade -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style is:global>
      body {
        font-family: 'Inter', sans-serif;
        background-color: #F8FAFC;
        color: #334155;
      }

      .section-spacing {
        @apply py-24 md:py-32;
      }
      
      .safe-container {
        @apply container mx-auto px-6 md:px-12;
      }

      ::selection {
        background-color: #FACC15;
        color: #000000;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-700 antialiased">
    
    <!-- Sticky Header com Backdrop Blur -->
    <header class="sticky top-0 z-40 backdrop-blur-md bg-white/90 border-b border-gray-200/80 shadow-sm transition-all duration-300">
      <div class="safe-container py-2 flex justify-between items-center">
        <!-- Logo -->
        <a href="/" class="transition-transform duration-300 hover:scale-105 active:scale-95 block">
          <img src="/logo.png" alt="Logotipo Precisão Metal" class="h-[120px] md:h-[196px] w-auto object-contain my-[-35px] md:my-[-60px]" />
        </a>

        <!-- Navegação Desktop -->
        <nav class="hidden lg:flex items-center gap-8 text-base font-bold text-gray-800">
          <a href="/" class="hover:text-secondary hover:scale-105 active:scale-95 transition-all duration-300">Inicio</a>
          <a href="/servicos" class="hover:text-secondary hover:scale-105 active:scale-95 transition-all duration-300">Serviços</a>
          <a href="/sobre" class="hover:text-secondary hover:scale-105 active:scale-95 transition-all duration-300">Sobre nós</a>
          <a href="/contato" class="hover:text-secondary hover:scale-105 active:scale-95 transition-all duration-300">Contato</a>
        </nav>

        <!-- Botões de Ação Desktop -->
        <div class="hidden lg:flex items-center gap-4">
          <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="bg-[#25D366] hover:bg-[#20ba59] text-white font-black px-5 py-2.5 rounded-xl text-sm transition-all duration-300 shadow-md shadow-emerald-600/20 hover:scale-105 active:scale-95 flex items-center gap-2">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.8 1.04 3.951 1.59 6.103 1.595h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Orçamento no WhatsApp
          </a>
        </div>

        <!-- Botão Abrir Menu Mobile (Hamburger) -->
        <button id="menu-open-btn" aria-label="Abrir Menu Mobile" class="lg:hidden p-2.5 text-secondary rounded-xl bg-slate-100 hover:bg-slate-200 transition-all duration-300 hover:scale-105 active:scale-95">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </header>

    <!-- DRAWER DE MENU MOBILE INDESTRUTÍVEL (UX DE ELITE) -->
    <div id="mobile-menu" class="fixed inset-0 z-[999] bg-accent/95 backdrop-blur-xl hidden flex-col justify-between p-8 text-white transition-all duration-300">
      <!-- Topo do Drawer: Logo + Botão Fechar X -->
      <div class="flex justify-between items-center border-b border-gray-800 pb-6">
        <a href="/" class="flex items-center">
          <img src="/logo.png" alt="Logotipo Precisão Metal" class="h-10 w-auto bg-white p-1.5 rounded-xl object-contain" />
        </a>
        <button id="menu-close-btn" aria-label="Fechar Menu Mobile" class="w-12 h-12 bg-white/10 hover:bg-white/20 text-white rounded-full flex items-center justify-center font-black text-2xl transition-all duration-300 hover:scale-105 active:scale-95 border border-white/20">
          ✕
        </button>
      </div>

      <!-- Links Centrais Gigantes -->
      <nav class="flex flex-col items-center justify-center gap-8 py-10">
        <a href="/" class="mobile-link text-3xl font-black text-white hover:text-primary transition-all duration-300 hover:scale-105 active:scale-95">Inicio</a>
        <a href="/servicos" class="mobile-link text-3xl font-black text-white hover:text-primary transition-all duration-300 hover:scale-105 active:scale-95">Serviços</a>
        <a href="/sobre" class="mobile-link text-3xl font-black text-white hover:text-primary transition-all duration-300 hover:scale-105 active:scale-95">Sobre nós</a>
        <a href="/contato" class="mobile-link text-3xl font-black text-white hover:text-primary transition-all duration-300 hover:scale-105 active:scale-95">Contato</a>
      </nav>

      <!-- Rodapé do Drawer: CTA Destacado -->
      <div class="space-y-4 pt-6 border-t border-gray-800 text-center">
        <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="mobile-link w-full bg-emerald-500 hover:bg-emerald-600 text-white font-black py-4 px-6 rounded-2xl text-base transition-all duration-300 shadow-xl shadow-emerald-500/30 hover:scale-105 active:scale-95 flex items-center justify-center gap-2">
          <span>💬</span> Conversar no WhatsApp
        </a>
      </div>
    </div>

    <!-- Conteúdo Principal -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Botão Flutuante do WhatsApp -->
    <WhatsAppBtn />

    <footer class="bg-secondary text-white pt-12 pb-6 border-t border-secondary">
      <div class="safe-container">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-8 pb-8 border-b border-blue-900/60">
          <div class="md:col-span-1 space-y-4">
            <div class="flex items-center gap-2 mb-6">
              <img src="/logo-footer.jpg" alt="Logotipo Precisão Metal" class="h-16 md:h-22 w-auto bg-white p-2 rounded-2xl object-contain" />
            </div>
            <p class="text-white text-base leading-relaxed">
              {SITE_CONFIG.description}
            </p>
            <!-- Ícones de Redes Sociais -->
            <div class="flex items-center gap-3 pt-2">
              <a href={SITE_CONFIG.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-8 h-8 rounded-full bg-white/10 hover:bg-primary hover:text-secondary flex items-center justify-center text-white transition-all duration-300">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c4.56-.93 8-4.96 8-9.75z"/>
                </svg>
              </a>
              <a href={SITE_CONFIG.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-8 h-8 rounded-full bg-white/10 hover:bg-primary hover:text-secondary flex items-center justify-center text-white transition-all duration-300">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051C.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Coluna 2: Navegação -->
          <div>
            <h4 class="text-primary font-black text-lg mb-6 tracking-wide uppercase">Navegação</h4>
            <ul class="space-y-3 text-base text-gray-100">
              <li class="flex items-center">
                <span class="text-blue-400 font-extrabold mr-2">›</span>
                <a href="/" class="hover:text-primary transition-all duration-300 hover:scale-105 inline-block">Inicio</a>
              </li>
              <li class="flex items-center">
                <span class="text-blue-400 font-extrabold mr-2">›</span>
                <a href="/servicos" class="hover:text-primary transition-all duration-300 hover:scale-105 inline-block">Serviços</a>
              </li>
              <li class="flex items-center">
                <span class="text-blue-400 font-extrabold mr-2">›</span>
                <a href="/sobre" class="hover:text-primary transition-all duration-300 hover:scale-105 inline-block">Sobre Nós</a>
              </li>
              <li class="flex items-center">
                <span class="text-blue-400 font-extrabold mr-2">›</span>
                <a href="/contato" class="hover:text-primary transition-all duration-300 hover:scale-105 inline-block">Contato</a>
              </li>
            </ul>
          </div>

          <!-- Coluna 3: Serviços -->
          <div>
            <h4 class="text-primary font-black text-lg mb-6 tracking-wide uppercase">Serviços</h4>
            <ul class="space-y-3 text-base text-gray-100">
              {servicosOrdenados.map((item) => (
                <li>
                  <a href={`/servicos/${item.slug}`} class="hover:text-primary transition-all duration-300 hover:scale-105 inline-block">
                    {shortTitles[item.slug] || item.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Coluna 4: Atendimento Local & Mapa -->
          <div class="space-y-4">
            <h4 class="text-primary font-black text-lg mb-4 tracking-wide uppercase">Atendimento Local & Mapa</h4>
            <div class="space-y-2 text-base text-gray-100">
              <p class="leading-snug">📍 {SITE_CONFIG.address.full}</p>
              <p>
                💬 <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-all duration-300">WhatsApp: {SITE_CONFIG.whatsappFormatted}</a>
              </p>
              <p class="text-[13px] xl:text-sm whitespace-nowrap">
                ✉️ {SITE_CONFIG.email}
              </p>
              <p class="text-sm text-slate-300">⏰ Seg a Sex: 07h30 às 18h | Sáb: 08h às 12h</p>
            </div>
            <!-- Mapa Pequeno Integrado -->
            <div class="rounded-2xl overflow-hidden border border-blue-900 shadow-lg aspect-video h-48">
              <iframe 
                title="Mapa de localização no rodapé da Serralheria Precisão Metal em Campinas"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3675.2588057271965!2d-47.12643662456488!3d-22.90382343729909!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94c8c704a43f8e5f%3A0xe54e24ebca74b2a4!2sAv.%20John%20Boyd%20Dunlop%2C%203520%20-%20Jardim%20Nova%20Esperan%C3%A7a%2C%20Campinas%20-%20SP%2C%2013060-803!5e0!3m2!1spt-BR!2sbr!4v1711234567890!5m2!1spt-BR!2sbr" 
                class="w-full h-full border-0" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>
        </div>

        <div class="flex flex-col md:flex-row justify-between items-center gap-6 text-xs text-gray-100">
          <div class="flex flex-col sm:flex-row items-center gap-4">
            <p>&copy; {new Date().getFullYear()} {SITE_CONFIG.name}. Todos os direitos reservados.</p>
            <div class="hidden sm:block text-blue-900/60">|</div>
            <div class="flex gap-4">
              <a href="/politica-de-privacidade" class="hover:text-primary transition-colors">Políticas de Privacidade</a>
              <span class="text-blue-900/60">|</span>
              <a href="/termos-de-uso" class="hover:text-primary transition-colors">Termos de Uso</a>
            </div>
          </div>
          <p class="font-bold text-primary">Plataforma Profissional para SEO Local & Alta Conversão ⚡</p>
        </div>
      </div>
    </footer>

    <!-- LÓGICA DE TRAVA DO MENU MOBILE -->
    <script>
      const openBtn = document.getElementById('menu-open-btn');
      const closeBtn = document.getElementById('menu-close-btn');
      const menu = document.getElementById('mobile-menu');
      const menuLinks = document.querySelectorAll('.mobile-link');

      function openMenu() {
        if (!menu) return;
        menu.classList.remove('hidden');
        menu.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeMenu() {
        if (!menu) return;
        menu.classList.remove('flex');
        menu.classList.add('hidden');
        document.body.style.overflow = '';
      }

      openBtn?.addEventListener('click', openMenu);
      closeBtn?.addEventListener('click', closeMenu);
      menuLinks.forEach((link) => link.addEventListener('click', closeMenu));
    </script>
  </body>
</html>
